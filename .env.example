# ============================================================
# TraceGraph AI — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── LLM Providers ───────────────────────────────────────────
# Configure one provider key. Requirement extraction and report narration
# fail closed if no real provider is available.
OPENAI_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=

# Provider selection: openai | groq | xai | grok
LLM_PROVIDER=openai

# Model selection:
# Use a model supported by the selected provider.
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ── GitHub (for PR analysis — read-only public repos) ────────
GITHUB_TOKEN=

# ── Neo4j ────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── Target ───────────────────────────────────────────────────
TARGET_REPO=
TARGET_PR=0

# ── Data paths ───────────────────────────────────────────────
DATA_DIR=./data

# ── Crawler ──────────────────────────────────────────────────
CRAWLER_BASE_URL=
CRAWLER_TIMEOUT=30000
CRAWLER_MAX_DEPTH=3

# ── Security ─────────────────────────────────────────────────
ALLOWED_CRAWL_DOMAINS=
ALLOWED_DOCUMENT_DOMAINS=
# In development, a public target can be approved for one crawl after SSRF
# checks. Production defaults to false; only enable it behind authenticated API access.
# ALLOW_CUSTOM_CRAWL_HOSTS=false
# Development keeps the local demo frictionless. In staging/production, set both
# APP_ENV=production and API_BEARER_TOKEN to protect state-changing endpoints.
APP_ENV=development
API_BEARER_TOKEN=
ALLOWED_ORIGINS=http://localhost:8000
LOG_LEVEL=INFO
