# ============================================================
# TraceGraph AI — Production API Dockerfile
# ============================================================

FROM python:3.10.14-slim-bookworm AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=8000

WORKDIR /app

# Install only runtime dependencies needed by Playwright.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy source before packaging so the installed wheel contains application code.
COPY pyproject.toml .
COPY app/ ./app/
COPY api/ ./api/

# Install runtime dependencies only; test tooling stays outside the image.
RUN pip install --upgrade pip && \
    pip install .

# A browser crawl is a required evidence source, so image creation must fail if
# Chromium cannot be installed.
RUN playwright install --with-deps chromium

COPY scripts/ ./scripts/
COPY docs/ ./docs/
COPY sample_output/ ./sample_output/
COPY evals/ ./evals/
COPY conftest.py .

# Create non-root user for security
RUN useradd -m -u 1000 appuser && \
    mkdir -p /app/data && \
    chown -R appuser:appuser /app

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

CMD ["uvicorn", "app.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
